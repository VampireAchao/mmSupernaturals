# Skins for the hall's stand-in players - optional.
#
# The hall does not need this file. It draws its own skins: two flat colours and a trim stripe
# per race, painted by SkinArt and served from a loopback port, so a stand-in reads as the race
# it is demonstrating without borrowing anybody's artwork. With no file here, that is what
# everybody wears.
#
# Copy this file to harness-skins.properties, in the project directory, only if you want
# different faces. It is git-ignored: a skin belongs to whoever made it, and this repository
# carries nobody's.
#
# For each name:
#   <name>.value      the base64 `textures` property of a profile
#   <name>.signature  its signature - or leave it empty for an unsigned texture, which the
#                     hall accepts because it sets enforce-secure-profile=false
#
# The value is a base64-encoded JSON blob of the shape a client expects:
#   {"textures":{"SKIN":{"url":"http://wherever-you-serve-it/<name>.png"}}}
# and the URL has to be reachable by the client, not by the server - the client is what fetches
# a skin. A file: URL will not do.
#
# Use a texture you made, or one you have permission to use. Do not paste somebody else's: this
# file is why the eleven that used to be in Skins.java could be taken out, and putting eleven
# others back in would only move the problem to a machine nobody can inspect.
#
# Models are not set here: a slim or classic body is part of the texture's own metadata, and a
# profile that says slim on an arm-sized model is a profile that draws wrong. The drawn skins
# are classic.

vampire.value=
vampire.signature=

ghoul.value=
ghoul.signature=

werewolf.value=
werewolf.signature=

demon.value=
demon.signature=

enderborn.value=
enderborn.signature=

priest.value=
priest.signature=

witchhunter.value=
witchhunter.signature=

angel.value=
angel.signature=

# The sparring master, and the sparring partner himself.
master.value=
master.signature=

# The recorder / observer / examiner in each room.
scribe.value=
scribe.signature=

# The target in each room: the one that gets killed, over and over.
human.value=
human.signature=
